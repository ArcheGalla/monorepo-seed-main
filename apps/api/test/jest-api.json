{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "api/.*\\.test\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testSequencer": "<rootDir>/api/test-sequencer.js",
  "watchPathIgnorePatterns": [
    "<rootDir>/api/.test-state.json"
  ]
}